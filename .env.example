# Supabase app runtime: copy the Transaction pooler URI (port 6543) from Project > Connect.
# Runtime uses node-postgres and a small pool; TLS is enabled by default.
DATABASE_URL=

# Drizzle migrations: use a Direct connection (5432) or Session pooler URI (5432).
# If your local network is IPv4-only, use the Session pooler rather than the Direct connection.
DIRECT_URL=
# Set false only for a local non-TLS PostgreSQL instance. Leave true for Supabase.
DATABASE_SSL=true

# Generate a unique secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Resend transactional email (required for production verification and password resets)
RESEND_API_KEY=
EMAIL_FROM=

# Realtime provider will be selected before room collaboration is implemented.
