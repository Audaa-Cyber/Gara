# Supabase app runtime: Transaction pooler URL (port 6543).
DATABASE_URL=
# Schema changes: Direct connection or Session pooler URL (port 5432).
DIRECT_URL=
# Keep true for Supabase; set false only for local PostgreSQL without TLS.
DATABASE_SSL=true

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Resend transactional email
RESEND_API_KEY=
EMAIL_FROM=
